FROM nginx:alpine AS runner

# Copia o dist pre-compilado pelo Cloud Build
COPY dist /usr/share/nginx/html

# Config nginx para SPA com Security Headers, Gzip expandido e Healthcheck
RUN printf 'server {\n\
  listen 8080;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  gzip on;\n\
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/wasm text/javascript;\n\
\n\
  add_header X-Frame-Options "DENY" always;\n\
  add_header X-Content-Type-Options "nosniff" always;\n\
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;\n\
\n\
  location /healthz {\n\
    access_log off;\n\
    return 200 "OK";\n\
    add_header Content-Type text/plain;\n\
  }\n\
\n\
  location / {\n\
    try_files $uri $uri/ /index.html;\n\
  }\n\
\n\
  location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|wasm)$ {\n\
    expires 1y;\n\
    add_header Cache-Control "public, immutable";\n\
    add_header X-Frame-Options "DENY" always;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/healthz || exit 1

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
