# Google Identity Platform / Firebase Auth (RevHackers Staging)
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=revhackers-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=revhackers-staging
VITE_GOOGLE_AUTH_ENABLED=true

# Google Cloud Platform (GCP Native Mode — 100% ativo)
VITE_GCP_API_URL=https://your-api-url.run.app
VITE_GCP_ENABLED=true
VITE_CLIENTS_GCP_ENABLED=true
VITE_GROWTHMAP_GCP_ENABLED=true
